# ==============================================================================
# Streamlit Secrets Template for PromotionAI (Firebase Configuration)
# Copy this file to `.streamlit/secrets.toml` and fill in your Firebase credentials.
# NEVER commit your real secrets.toml or serviceAccountKey.json to git.
# ==============================================================================

# Option 1: Path to local Service Account JSON file (recommended for local dev)
[firebase]
service_account_path = "serviceAccountKey.json"

# Option 2: Direct Service Account JSON fields (recommended for Streamlit Cloud deployment)
# [firebase.service_account]
# type = "service_account"
# project_id = "your-firebase-project-id"
# private_key_id = "your-private-key-id"
# private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# client_email = "firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com"
# client_id = "1234567890"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"

# Optional: Firebase Web API Key (found in Firebase Project Settings > General)
# Used for direct REST password authentication
[firebase.auth]
web_api_key = "AIzaSyYourWebApiKeyHere"
